rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'valerkasvetlicenco@icloud.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/marketUsers/$(request.auth.uid));
    }

    function isApproved() {
      return signedIn()
        && userDoc().data.approved == true
        && userDoc().data.blocked != true;
    }

    match /marketUsers/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && (
          (isAdmin() && request.resource.data.role == 'admin' && request.resource.data.approved == true)
          ||
          (!isAdmin() && request.resource.data.role == 'user' && request.resource.data.approved == false)
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'phone', 'department', 'updatedAt'
          ])
        );

      allow delete: if isAdmin();
    }

    match /marketListings/{listingId} {
      allow read: if isApproved() || isAdmin();

      allow create: if isApproved()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.active == true;

      allow update: if isAdmin()
        || (isApproved() && resource.data.sellerId == request.auth.uid)
        || (
          isApproved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
          && request.resource.data.stock >= 0
          && request.resource.data.stock < resource.data.stock
        );

      allow delete: if isAdmin()
        || (isApproved() && resource.data.sellerId == request.auth.uid);
    }

    match /marketOrders/{orderId} {
      allow create: if isApproved()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.status == 'noua';

      allow read: if isAdmin()
        || (isApproved() && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        ));

      allow update: if isAdmin()
        || (
          isApproved()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        );

      allow delete: if isAdmin();
    }
  }
}
